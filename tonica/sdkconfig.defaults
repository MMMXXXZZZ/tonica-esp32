# Target: YD-ESP32-S3 N16R8 (ESP32-S3-WROOM-1, 16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n

# Octal PSRAM (N16R8). GPIO35-37 are consumed by the PSRAM interface.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Console on UART0 (CH343 "COM" port on this board)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20

# TLS: buffers in PSRAM, Mozilla CA bundle, dynamic record buffers
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_HARDWARE_MPI=y

# Wi-Fi / lwIP sized for streaming
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_SNTP_MAX_SERVERS=2

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# USB host audio: dongles use isochronous OUT packets up to ~400 B (48 kHz/32-bit stereo = 384 B)
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y
CONFIG_UAC_NUM_ISOC_URBS=8
CONFIG_UAC_NUM_PACKETS_PER_URB=8

# OTA: a new image must prove itself (Wi-Fi + Spotify login) or the bootloader reverts
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024



# Memory (measured 2026-11-02): mDNS task + allocations in PSRAM; Wi-Fi static TX pool 16 -> 10
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_MAX_INTERFACES=1
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
# lwIP TCP/IP task on core 0 with the rest of networking (unpinned it could preempt the decoder on core 1)
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Data cache lines 64 B (default 32): the decoder and the audio rings live in PSRAM, so each miss
# should fetch more. Measured on the board 2026-11-03: decode 5.89x -> 6.32x realtime, playback clean.
# CONFIG_ESP32S3_DATA_CACHE_LINE_32B is not set
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
